# คัดลอกไฟล์นี้เป็น .env (วางไว้ข้าง config.py) แล้วใส่ค่าจริง — .env ถูก gitignore ไว้ ห้าม commit

# ใช้เซ็น session cookie สุ่มด้วย: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ต้องตรงกับ --api-auth user:pass ใน Launch Options ของ Forge (PC3)
# ปล่อยว่างทั้งคู่ได้ถ้า Forge ไม่ได้ตั้ง --api-auth
FORGE_API_USER=
FORGE_API_PASS=

# ต้องตรงกับ DB_TOKEN ใน pc4-database/.env
DB_TOKEN=

# ตั้งเป็น true เฉพาะตอนพัฒนาบนเครื่องตัวเอง (เปิด debugger ของ Flask)
FLASK_DEBUG=false

# กันสแปม /api/generate: ต้องรอกี่วินาทีก่อนสั่งสร้างภาพครั้งถัดไป (ต่อ user, 0 = ไม่จำกัด)
GENERATE_COOLDOWN_SECONDS=3
