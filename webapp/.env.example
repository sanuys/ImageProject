# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env ถูก gitignore ไว้แล้ว ห้าม commit)

# สุ่มด้วยคำสั่ง: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# IP:port ของเครื่อง AI Server (Stability Matrix / Forge) ในวง LAN
FORGE_API_URL=http://127.0.0.1:7860
# ต้องตรงกับ --api-auth ที่ตั้งไว้ใน Launch Options ของ Forge
FORGE_API_USER=
FORGE_API_PASS=

# ตั้งเป็น true เฉพาะตอน dev เท่านั้น (เปิด debugger/auto-reload ของ Flask)
FLASK_DEBUG=false

# พอร์ตที่ Flask จะรัน (ค่า default คือ 5000)
PORT=5000

# Comma-separated list ของ origin ที่อนุญาตให้เรียก API ข้าม origin ได้ (CORS)
# ปล่อยว่างไว้ถ้า frontend ยังรันอยู่ใน Flask เดียวกัน (เช่น http://192.168.1.10)
ALLOWED_ORIGINS=

# กันสแปม /api/generate: ต้องรอกี่วินาทีก่อนยิงคำขอสร้างภาพครั้งถัดไป (ต่อ user)
GENERATE_COOLDOWN_SECONDS=3
